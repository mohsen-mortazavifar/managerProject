# Central Repair_Master database connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=Repair_Master
DB_USER=your_app_user
DB_PASSWORD=replace_with_a_secret
DB_ENCRYPT=true
# Use true only for local development with a trusted self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=false

# Set true ONLY when a trusted reverse proxy overwrites X-Real-IP / X-Forwarded-For.
# Leave false when the app is directly internet-accessible or proxy behavior is unknown.
TRUST_PROXY_HEADERS=false

# JWT signing secret: generate a random secret of at least 32 bytes.
# Example generation: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret

# OTP HMAC secret: use a different random secret with at least 32 bytes
OTP_SECRET=replace_with_a_different_long_random_secret

# Optional generic SMS HTTP adapter. Configure after selecting a provider.
# Sends POST JSON {"to":"+...","message":"..."} with Bearer API key.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

# Local development only. Never enable in production.
OTP_DEV_LOG=false

# Optional database server label stored for tenant provisioning
TENANT_DB_SERVER=
