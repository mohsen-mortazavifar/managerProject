# Central Repair_Master database connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=Repair_Master
DB_USER=your_app_user
DB_PASSWORD=replace_with_a_secret
DB_ENCRYPT=true
# Use true only for local development with a trusted self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=false

# Set true ONLY when a trusted reverse proxy overwrites X-Real-IP / X-Forwarded-For.
# Leave false when the app is directly internet-accessible or proxy behavior is unknown.
TRUST_PROXY_HEADERS=false

# JWT signing secret: generate a random secret of at least 32 bytes.
# Example generation: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret


# Repair server-to-server integration. Must match Repair's MASTER_REPAIR_INTEGRATION_KEY.
REPAIR_INTEGRATION_SECRET=replace_with_same_32_byte_or_longer_secret_configured_in_Repair

# AES-256-GCM key used to encrypt newly provisioned tenant connection details.
# Generate a random 32-byte key and encode as 64 hex chars (e.g. openssl rand -hex 32).
# Keep this key in a secret manager; do not commit a real key or rotate without re-encrypting stored values.
TENANT_CONNECTION_ENCRYPTION_KEY=replace_with_64_hex_characters

# Tenant application SQL account: least-privilege login with access to tenant databases.
# Do not use the Master database admin account here.
TENANT_DB_USER=tenant_application_user
TENANT_DB_PASSWORD=replace_with_a_strong_secret
TENANT_DB_PORT=1433

# Optional explicit allow-list for tenant SQL Server hosts; semicolon-separated.
# If unset, provisioning only permits DB_SERVER itself.
TENANT_DB_ALLOWED_SERVERS=sql01.example.com;sql02.example.com
